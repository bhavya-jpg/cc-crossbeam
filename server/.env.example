# Copy to server/.env. That file is gitignored and is loaded automatically in local runs.

# Supabase (required)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Otari inference. With this empty, a non-production server runs in demo simulation.
OTARI_API_KEY=
# OTARI_BASE_URL=https://otari.ai/api/v1

# Sent on GET /organizations/me/traces only. See OTARI_FRICTION_LOG.md, finding 2.
# OTARI_MASTER_KEY=

# true forces placeholder responses even with a key; false fails instead of simulating.
# OTARI_DEMO_SIMULATION=true

# true runs the guardrail in block mode on a known injection string.
# OTARI_SIMULATE_GUARDRAIL_BLOCK=true

# Contractor virtual key for runs, with its display name. Unset uses OTARI_API_KEY.
# OTARI_CONTRACTOR_KEY=
# OTARI_CONTRACTOR_KEY_LABEL=vk_contractor_placentia_01
# Display cap for the Inspector's budget bar. The gateway's own ceiling is what refuses spend.
# OTARI_CONTRACTOR_BUDGET_USD=5.00

# Public URL of /api/mcp/adu-law, reachable from the gateway. Unset or localhost uses
# the local tool loop. MCP_ADU_LAW_TOKEN requires a bearer token and an https URL.
# OTARI_MCP_PUBLIC_URL=https://your-server.example.com/api/mcp/adu-law
# MCP_ADU_LAW_TOKEN=

# Model overrides, per role: EXTRACTOR, RESEARCHER, ANALYST, DRAFTER.
# OTARI_MODEL_RESEARCHER=openai/gpt-oss-120b
# OTARI_MODEL_RESEARCHER_FALLBACK=openai/gpt-oss-20b

# Cost estimate used only when a response omits usage.cost_usd.
# OTARI_FALLBACK_INPUT_USD_PER_1K=0.003
# OTARI_FALLBACK_OUTPUT_USD_PER_1K=0.015
